---
import MetaPage from "@/components/MetaPage.astro"
import Layout from "@/layouts/Layout.astro"
import BlogCard from "@/components/BlogCard.astro"
import ProjectCard from "@/components/ProjectCard.astro"
import { getCollection } from "astro:content"
import { getPosts } from "@/lib/content"

const projects = (await getCollection("projects"))
  .filter((entry) => entry.data.featured)
  .sort((a,b) => (a.data.order ?? 99) - (b.data.order ?? 99))
  .slice(0, 3)
const recentPosts = (await getPosts()).slice(0, 2)
---
<Layout>
  <MetaPage slot="head" title="Home" />
  <section class="home-hero" aria-label="Introduction">
    <div class="hero-body">
      <h1>Hi, I'm Kien.</h1>
      <p class="hero-role">Full-stack developer · Building for the web</p>
      <prose-content>
        <p>I build web applications, APIs, and the infrastructure behind them. This is my small corner of the internet for <a href="/projects">projects</a> and <a href="/blog">notes</a>.</p>
        <p>I enjoy working on the details — from how an interface feels to how a service behaves in production.</p>
      </prose-content>
      <div class="hero-links">
        <a href="/projects">Projects</a>
        <a href="https://github.com/TNTKien" target="_blank" rel="noopener noreferrer">GitHub</a>
      </div>
    </div>
  </section>
  <section class="home-section" aria-labelledby="featured-title">
    <div class="section-header"><h2 id="featured-title">Recent projects</h2><a href="/projects">View all</a></div>
    <ul class="section-items">
      {projects.map((project) => <ProjectCard project={project} />)}
    </ul>
  </section>
  <section class="home-section" aria-labelledby="writing-title">
    <div class="section-header"><h2 id="writing-title">Recent writing</h2><a href="/blog">All posts</a></div>
    {recentPosts.length ? (
      <ul class="section-items">{recentPosts.map((post) => <BlogCard post={post}/>)}</ul>
    ) : <p class="no-posts">No notes published yet.</p>}
  </section>
</Layout>

<style>
  .home-hero {
    position: relative;
    margin-block-end: var(--space-xl);
  }
  .hero-body {
    position: relative;
    width: 100%;
  }
  h1 {
    font-size: var(--step-3);
    font-weight: var(--font-weight-medium);
    line-height: calc(var(--leading-offset) + 1em);
  }
  .hero-role {
    color: var(--brand);
    font-size: var(--step--1);
    margin-block: var(--space-3xs) var(--space-m);
  }
  .hero-body prose-content {
    max-width: 34rem;
  }
  .hero-body prose-content p + p { margin-top: var(--space-2xs); }
  .hero-links {
    display: flex;
    gap: var(--space-m);
    margin-top: var(--space-s);
    font-size: var(--step--1);
  }
  .hero-links a { color: var(--brand); }
  .hero-links a:hover { text-decoration: underline; }
  .home-section + .home-section { margin-block-start: var(--space-xl); }
  .section-header {
    display: flex;
    justify-content: space-between;
    gap: var(--space-xs);
    align-items: baseline;
    margin-bottom: var(--space-m);
  }
  .section-header h2 { font-size: var(--step-2); font-weight: var(--font-weight-medium); }
  .section-header a { font-size: var(--step--1); color: var(--brand); }
  .section-header a:hover { text-decoration: underline; }
  .section-items { display: flex; flex-direction: column; gap: var(--space-m); }
  .no-posts { color: var(--muted-foreground); }
</style>
