---
import AuthorCard from "@/components/AuthorCard.astro"
import MetaPage from "@/components/MetaPage.astro"
import Layout from "@/layouts/Layout.astro"
import { getCollection } from "astro:content"
const authors = await getCollection("authors")
---
<Layout>
  <MetaPage slot="head" title="About" description="About Kien, the developer behind this site." />
  <header><h1>About</h1><p>Building web applications and learning along the way.</p></header>
  <ul>{authors.map(author => <AuthorCard author={author} />)}</ul>
</Layout>
<style>
  header { margin-bottom: var(--space-l); }
  h1 { font-size: var(--step-3); font-weight: var(--font-weight-medium); }
  header p { color: var(--muted-foreground); margin-top: var(--space-3xs); }
  ul { display:flex; flex-direction:column; gap:var(--space-m); }
</style>
