---
import sansWoff2 from "@/assets/fonts/IBMPlexSans-VariableFont_wdth,wght.woff2?url"
import sansItalicWoff2 from "@/assets/fonts/IBMPlexSans-Italic-VariableFont_wdth,wght.woff2?url"
import { SITE } from "@/consts"
---

<head>
  <meta charset="utf-8">
  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0, user-scalable=yes"
  >
  <meta name="generator" content={Astro.generator}>

  <meta name="HandheldFriendly" content="True">
  <meta name="mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="default">
  <meta name="apple-mobile-web-app-title" content={SITE.title}>
  <meta
    name="format-detection"
    content="telephone=no,date=no,address=no,email=no,url=no"
  >

  <meta name="theme-color" content="#101712">

  <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=3">

  <link rel="sitemap" href="/sitemap-index.xml">
  <link
    rel="alternate"
    type="application/rss+xml"
    title={SITE.title}
    href={new URL("rss.xml", Astro.site)}
  >

  <link rel="preload" href={sansWoff2} as="font" type="font/woff2" crossorigin>
  <link
    rel="preload"
    href={sansItalicWoff2}
    as="font"
    type="font/woff2"
    crossorigin
  >

  <script is:inline>
    // Default to dark unless the visitor previously selected light.
    let theme = "dark"
    try {
      if (localStorage.getItem("theme") === "light") theme = "light"
    } catch {}
    document.documentElement.dataset.theme = theme
    document.querySelector('meta[name="theme-color"]')?.setAttribute(
      "content",
      theme === "dark" ? "#101712" : "#fbfcfa",
    )
  </script>

  <slot />
</head>
